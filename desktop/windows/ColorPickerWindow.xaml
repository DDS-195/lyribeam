<Window x:Class="LyricBridge.ColorPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="选择颜色" Width="360" Height="450" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
 UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="SwatchButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Ring" CornerRadius="15" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="#18FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#C8BAF7"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="AcceptButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
    <Setter Property="Background" Value="#C8BAF7"/><Setter Property="Foreground" Value="#221A32"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".90"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Border Margin="12" Padding="22,18" CornerRadius="20" Background="#FE24212C" BorderBrush="#27FFFFFF" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity=".32"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Header_Drag" Margin="0,0,0,14">
    <StackPanel><TextBlock x:Name="PickerTitle" Text="选择颜色" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="拖动选色，或直接输入色值" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
    <Button Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="Cancel_Click" ToolTip="取消并关闭" AutomationProperties.Name="关闭颜色选择器"/>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource QuietScrollViewer}">
    <StackPanel Margin="0,0,2,0">
     <Grid x:Name="Spectrum" Height="130" Background="Transparent" Focusable="True"
      AutomationProperties.Name="饱和度与亮度，方向键微调"
      SizeChanged="Spectrum_SizeChanged" MouseLeftButtonDown="Spectrum_Down" MouseMove="Spectrum_Move"
      MouseLeftButtonUp="Spectrum_Up" KeyDown="Spectrum_KeyDown" Cursor="Cross">
      <Grid x:Name="ColorSurface">
       <Border x:Name="HueSurface" Background="Red"/>
       <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
       <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      </Grid>
      <Canvas IsHitTestVisible="False"><Grid x:Name="ColorPointer" Width="16" Height="16"><Ellipse Stroke="#65000000" StrokeThickness="3"/><Ellipse Margin="1" Stroke="White" StrokeThickness="2"/></Grid></Canvas>
     </Grid>
     <Slider x:Name="HueSlider" Minimum="0" Maximum="360" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" Height="22" Margin="0,10,0,0" ValueChanged="Hue_Changed" AutomationProperties.Name="色相">
      <Slider.Template><ControlTemplate TargetType="Slider">
       <Grid Height="22">
        <Border Height="8" CornerRadius="4" Margin="7,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset=".1667"/><GradientStop Color="#00FF00" Offset=".3333"/><GradientStop Color="#00FFFF" Offset=".5"/><GradientStop Color="#0000FF" Offset=".6667"/><GradientStop Color="#FF00FF" Offset=".8333"/><GradientStop Color="#FF0000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
         <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
         <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F5F3F8" Stroke="#51465F" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
         <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
       </Grid>
      </ControlTemplate></Slider.Template>
     </Slider>
     <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="SelectedSwatch" CornerRadius="9" Background="#F5F3F8" BorderBrush="#32FFFFFF" BorderThickness="1"/>
      <Border Grid.Column="2" Background="#17151E" BorderBrush="#40384B" BorderThickness="1" CornerRadius="9" Padding="11,0">
       <TextBox x:Name="HexInput" Height="34" VerticalContentAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="13"
        Foreground="#F5F3F8" CaretBrush="#C8BAF7" Background="Transparent" BorderThickness="0" MaxLength="32"
        AutomationProperties.Name="十六进制颜色" TextChanged="Hex_Changed" GotKeyboardFocus="Hex_Focused"/>
      </Border>
     </Grid>
     <TextBlock x:Name="ValidationHint" Height="16" FontSize="10" Foreground="#E4A5B8" Margin="0,4,0,0"/>
     <UniformGrid x:Name="SwatchPanel" Columns="9" Margin="0,10,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Content="取消" Margin="0,0,5,0" Style="{StaticResource SoftButton}" Click="Cancel_Click" AutomationProperties.Name="取消颜色修改"/>
    <Button x:Name="AcceptButton" Grid.Column="1" Content="使用颜色" Margin="5,0,0,0" Style="{StaticResource AcceptButton}" Click="Accept_Click" AutomationProperties.Name="使用所选颜色"/>
   </Grid>
  </Grid>
 </Border>
</Window>
