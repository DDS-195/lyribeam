<Window x:Class="LyricBridge.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="LyricBridge.ico" Title="蓝牙歌词" Width="660" Height="160" MinWidth="660" MaxWidth="660" MinHeight="160" MaxHeight="160" SizeToContent="Manual" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False"
 FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
 MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseLeftButtonDown="Window_MouseLeftButtonDown"
 MouseRightButtonUp="Window_MouseRightButtonUp">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="CaptureRoot" Background="Transparent">
  <Border x:Name="Card" CornerRadius="18" Margin="12,8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="20,8">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#ED27242F" Offset="0"/><GradientStop Color="#F014151B" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="#000000"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="TrackInfo" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
      <Border x:Name="StateDot" Width="4" Height="4" CornerRadius="2" Background="#B4A2DF" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="TrackTitle" Text="蓝牙歌词" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
      <TextBlock x:Name="TrackArtist" Text="  /  等待手机连接" Foreground="#93919F" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="140" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel x:Name="HoverControls" Grid.Column="1" Orientation="Horizontal" Opacity="0" IsHitTestVisible="False">
      <Button x:Name="LockButton" Content="&#xE72E;" ToolTip="锁定歌词（鼠标穿透）&#x0a;解锁：右键托盘图标" AutomationProperties.Name="锁定歌词（鼠标穿透）" Style="{StaticResource IconButton}" Width="26" Height="26" Click="Lock_Click"/>
      <Button Content="&#xE739;" ToolTip="切换卡片 / 纯文字" Style="{StaticResource IconButton}" Width="26" Height="26" Click="Mode_Click"/>
      <Button Content="&#xE713;" ToolTip="显示设置" Style="{StaticResource IconButton}" Width="26" Height="26" Click="Settings_Click"/>
      <Button Content="&#xE921;" ToolTip="收起到托盘" Style="{StaticResource IconButton}" Width="26" Height="26" Click="Hide_Click"/>
     </StackPanel>
    </Grid>
    <StackPanel VerticalAlignment="Center" x:Name="LyricBlock" Grid.Row="1">
     <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
     <Viewbox x:Name="CurrentLineFit" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" MaxHeight="54">
      <TextBlock x:Name="CurrentLine" Text="让音乐，轻轻留在桌面" TextAlignment="Center" TextWrapping="NoWrap" FontSize="30" FontWeight="SemiBold" LineHeight="39" LineStackingStrategy="BlockLineHeight">
       <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.6" Color="#000000"/></TextBlock.Effect>
      </TextBlock>
     </Viewbox>
     <TextBlock x:Name="NextLine" Text="在手机助手里，开始蓝牙同步" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="16" Foreground="#9792A5" Margin="0,4,0,0" LineHeight="20" LineStackingStrategy="BlockLineHeight">
      <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6" Color="#000000"/></TextBlock.Effect>
     </TextBlock>
    </StackPanel>
    <Grid Grid.Row="2" x:Name="Footer">
     <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="18"/></Grid.RowDefinitions>
     <Border x:Name="ProgressTrack" Background="#15FFFFFF" CornerRadius="1"/>
     <Border x:Name="ProgressFill" Background="#BBADA3DB" CornerRadius="1" HorizontalAlignment="Left" Width="0"/>
     <Grid Grid.Row="1" Margin="0,5,0,0">
      <TextBlock x:Name="StateCaption" Text="蓝牙直连" FontSize="9" Foreground="#898392" HorizontalAlignment="Left"/>
      <TextBlock x:Name="TimeCaption" Text="等待手机播放" FontSize="9" Foreground="#898392" HorizontalAlignment="Right"/>
     </Grid>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
